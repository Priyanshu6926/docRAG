# ==========================================
# DocTalk Environment Variables Configuration
# ==========================================

# --- Node Backend API Configuration ---
PORT=5000
MONGO_URI=mongodb://localhost:27017/doctalk
JWT_SECRET=doctalk_super_secret_jwt_key_2026

# --- Internal RAG Microservice URL (Python FastAPI) ---
PYTHON_SERVICE_URL=http://localhost:8000

# --- LLM API Keys ---
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Anthropic Claude API Key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Vector Store & Embedding Configuration ---
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Frontend API Base URL (For frontend/.env) ---
# VITE_API_BASE_URL=http://localhost:5000/api
